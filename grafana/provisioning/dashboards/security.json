{
  "uid": "edgeucate-security",
  "title": "Security: Trivy Vulnerability Monitoring",
  "tags": ["security", "trivy"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "1h",
  "time": {"from": "now-7d", "to": "now"},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CRITICAL vulnerabilities",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 0, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(trivy_vulnerabilities{severity=\"critical\"}) or vector(0)", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "HIGH vulnerabilities",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 6, "y": 0},
      "targets": [{"refId": "A", "expr": "sum(trivy_vulnerabilities{severity=\"high\"}) or vector(0)", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 10}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Hours since last scan",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 6, "w": 6, "x": 12, "y": 0},
      "targets": [{"refId": "A", "expr": "(time() - trivy_last_scan_timestamp) / 3600", "instant": true}],
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "unit": "h", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 26}]}}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Dynamics by severity",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "targets": [{"refId": "A", "expr": "sum by (severity) (trivy_vulnerabilities)", "legendFormat": "{{severity}}"}],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CRITICAL+HIGH by image",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "targets": [{"refId": "A", "expr": "sum by (image) (trivy_vulnerabilities{severity=~\"critical|high\"})", "legendFormat": "{{image}}"}],
      "fieldConfig": {"defaults": {"color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}}
    },
    {
      "id": 6,
      "type": "table",
      "title": "By image and severity (current)",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 14},
      "targets": [{"refId": "A", "expr": "trivy_vulnerabilities > 0", "instant": true, "format": "table"}],
      "transformations": [
        {"id": "organize", "options": {"excludeByName": {"Time": true, "instance": true, "job": true, "__name__": true}, "renameByName": {"Value": "count", "image": "image", "severity": "severity"}}},
        {"id": "sortBy", "options": {"desc": true, "fields": ["count"]}}
      ],
      "fieldConfig": {"defaults": {"custom": {"align": "auto", "cellOptions": {"type": "auto"}}, "filterable": true}, "overrides": []},
      "options": {"showHeader": true}
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Trivy findings (critical/high)",
      "datasource": {"type": "loki", "uid": "loki"},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 14},
      "targets": [{"refId": "A", "expr": "{service=\"trivy-monitor\", severity=~\"critical|high\"}"}],
      "options": {"showTime": true, "showLabels": false, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true, "dedupStrategy": "none"}
    }
  ]
}